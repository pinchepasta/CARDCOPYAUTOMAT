<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/p70_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CARDCOPY//AUTOMAT v.1.2 - INFO"
            android:fontFamily="monospace"
            android:textColor="@color/p70_orange"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="An automated tool for offloading media from external cards to internal storage and cloud services."
            android:fontFamily="monospace"
            android:textColor="@color/p70_orange"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEVELOPED BY"
            android:fontFamily="monospace"
            android:textColor="@color/p70_orange"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/websiteLink"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:src="@drawable/fllogo"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginBottom="48dp"
            android:alpha="0.9"
            android:contentDescription="https://feinlabs.de" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="RETURN TO SYSTEM"
            android:fontFamily="monospace"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/p70_orange"
            app:strokeColor="@color/p70_orange"
            app:strokeWidth="2dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Square"
            app:rippleColor="@color/p70_orange_bg" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/p70_overlay"
        android:alpha="0.15"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
